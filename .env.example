# ===== Supabase (avis) =====
# Project URL (Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key (Settings → API → service_role secret) — NE JAMAIS exposer côté client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ===== Modération =====
# Mot de passe simple pour /admin/avis (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme-some-strong-password
# Email destinataire des notifications
ADMIN_EMAIL=souslesetoiles974@gmail.com

# ===== Resend (envoi d'email) =====
# https://resend.com — clé API gratuite (100 emails/jour)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Adresse expéditeur (doit être validée sur ton domaine dans Resend, ou laisser onboarding@resend.dev pour tester)
RESEND_FROM=avis@fgpeople.com

# ===== Cloudinary (captures d'écran des avis sur les sites) =====
# Dashboard Cloudinary → le "Cloud name" est le nom de l'environnement,
# visible dans CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=000000000000000
# Secret : jamais préfixé NEXT_PUBLIC_, il signe les uploads côté serveur
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Sécurité hash IP =====
# Sel utilisé pour hasher les IP avant stockage (anonymisation)
REVIEW_IP_SALT=change-me-to-a-long-random-string
